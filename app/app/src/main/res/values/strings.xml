    <string name="module_blocker_title">Blocker Controller</string>
    <string name="module_blocker_subtitle">Disable heavy background services.</string>
    <string name="module_blocker_desc">Enforces the disabled state of targeted background components (such as specific GMS analytics and ad services) to reduce unnecessary resource consumption and wakeups.</string>

    <string name="module_cleaner_title">Cleaner Controller</string>
    <string name="module_cleaner_subtitle">Opportunistic cache &amp; stale data cleanup.</string>
    <string name="module_cleaner_desc">Performs opportunistic background cleanup of cache and stale data based on system load, thermal conditions, and storage pressure. Designed to minimize impact on active applications and foreground tasks.</string>

    <string name="module_cpu_title">CPU Controller</string>
    <string name="module_cpu_subtitle">Dynamic CFS scheduler tuning.</string>
    <string name="module_cpu_desc">Dynamically manages kernel CFS scheduler parameters and UClamp based on system load pressure (PSI) and thermal conditions. Protects the throughput of active tasks while maintaining maximum responsiveness.</string>

    <string name="module_storage_title">Storage Controller</string>
    <string name="module_storage_subtitle">Block device I/O queue tuning.</string>
    <string name="module_storage_desc">Tunes block device I/O queues and read-ahead memory dynamically to maximize data throughput and drastically reduce disk access latency during I/O congestion.</string>

    <string name="module_tweaks_title">System Tweaks</string>
    <string name="module_tweaks_subtitle">Apply static kernel optimizations.</string>
    <string name="module_tweaks_desc">Applies a curated set of static kernel configurations, I/O scheduler parameters, and system properties at boot to significantly improve network latency and overall system stability.</string>

