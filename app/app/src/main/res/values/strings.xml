    <string name="module_blocker_title">Service Blocker</string>
    <string name="module_blocker_subtitle">Disables background tracking services.</string>
    <string name="module_blocker_desc">Disables specific tracking, analytics, and diagnostic services in the background to reduce unnecessary battery and data consumption.</string>

    <string name="module_cleaner_title">System Cleaner</string>
    <string name="module_cleaner_subtitle">Removes cache and obsolete files.</string>
    <string name="module_cleaner_desc">Removes cache and junk files in the background. It monitors the device temperature and workload to run cleanups only when the system is idle.</string>

    <string name="module_cpu_title">CPU Control</string>
    <string name="module_cpu_subtitle">Balances responsiveness and power.</string>
    <string name="module_cpu_desc">Monitors the workload and temperature to dynamically adjust processor performance. It maintains device responsiveness during active use and conserves power when idle.</string>

    <string name="module_storage_title">Storage Control</string>
    <string name="module_storage_subtitle">Manages read/write data queues.</string>
    <string name="module_storage_desc">Adjusts data queues and read-ahead memory on the internal storage to maintain file access stability, especially during background multitasking.</string>

    <string name="module_tweaks_title">System Tweaks</string>
    <string name="module_tweaks_subtitle">Applies boot-time configurations.</string>
    <string name="module_tweaks_desc">Applies specific system settings every time the device boots up to manage RAM allocation, network connections, and system scheduling.</string>

    <string name="error_config_missing_title">Config Not Found</string>
    <string name="error_config_missing_desc">The configuration file is missing. Please reinstall the Magisk module to restore it.</string>

    <string name="advanced_cpu_title">CPU Performance Limits</string>
    <string name="advanced_storage_title">Storage Performance Limits</string>

    <string name="advanced_cpu_desc">Manually define the minimum and maximum performance boundaries for the processor. Leave these empty to use the system defaults.</string>
    <string name="advanced_storage_desc">Set the read speeds and data queue capacity on the internal storage. Leave these empty to use the system defaults.</string>
    <string name="advanced_module_disabled">Enable the main feature in the Modules menu to use advanced settings.</string>

