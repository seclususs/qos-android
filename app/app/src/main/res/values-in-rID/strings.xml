    <string name="error_daemon_missing_title">Daemon Tidak Ditemukan</string>
    <string name="error_daemon_missing_desc">Biner inti sistem tidak ditemukan. Pastikan modul Magisk QoS sudah terpasang dan aktif, lalu mulai ulang perangkat.</string>

    <string name="module_blocker_title">Pemblokir Layanan</string>
    <string name="module_blocker_subtitle">Menonaktifkan layanan latar belakang.</string>
    <string name="module_blocker_desc">Menonaktifkan layanan pelacakan, analitik, dan diagnostik di latar belakang untuk mengurangi penggunaan daya dan kuota internet yang tidak perlu.</string>

    <string name="module_cleaner_title">Pembersih Sistem</string>
    <string name="module_cleaner_subtitle">Menghapus cache dan file usang.</string>
    <string name="module_cleaner_desc">Menghapus cache dan file sampah di latar belakang. Fitur ini memantau suhu dan beban kerja perangkat agar pembersihan hanya berjalan saat sistem sedang tidak sibuk.</string>

    <string name="module_cpu_title">Kontrol CPU</string>
    <string name="module_cpu_subtitle">Menyeimbangkan responsivitas dan daya.</string>
    <string name="module_cpu_desc">Memantau beban dan suhu perangkat untuk menyesuaikan kinerja prosesor. Fitur ini menjaga responsivitas perangkat saat digunakan dan menghemat daya saat sedang diam.</string>

    <string name="module_storage_title">Kontrol Penyimpanan</string>
    <string name="module_storage_subtitle">Mengelola antrean baca/tulis data.</string>
    <string name="module_storage_desc">Menyesuaikan kapasitas antrean data dan prabaca memori internal untuk menjaga stabilitas akses file, terutama saat perangkat menjalankan banyak tugas di latar belakang.</string>

    <string name="module_tweaks_title">Penyesuaian Sistem</string>
    <string name="module_tweaks_subtitle">Menerapkan konfigurasi saat proses boot.</string>
    <string name="module_tweaks_desc">Menerapkan pengaturan sistem setiap kali perangkat dinyalakan untuk mengelola alokasi RAM, koneksi jaringan, dan penjadwalan sistem.</string>

    <string name="error_config_missing_title">Konfigurasi Tidak Ditemukan</string>
    <string name="error_config_missing_desc">File konfigurasi hilang. Silakan instal ulang modul Magisk untuk mengembalikannya.</string>

    <string name="advanced_cpu_title">Batas Performa CPU</string>
    <string name="advanced_storage_title">Batas Performa Penyimpanan</string>

    <string name="advanced_cpu_desc">Tentukan batas kecepatan dan gaya kerja prosesor secara manual. Kosongkan bagian ini untuk menggunakan pengaturan bawaan dari sistem.</string>
    <string name="advanced_storage_desc">Atur batas kecepatan baca dan kapasitas antrean data pada memori internal. Kosongkan bagian ini untuk menggunakan pengaturan bawaan dari sistem.</string>
    <string name="advanced_module_disabled">Aktifkan fitur utama di menu Modul untuk menggunakan pengaturan lanjutan.</string>

